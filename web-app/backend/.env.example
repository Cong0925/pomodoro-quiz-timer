# ============================================================
# 刷题计时器 - 配置文件模板
# 复制本文件为 .env 并按需修改；.env 已被 gitignore，不会外泄
# 新电脑部署完整步骤见 README「四、迁移到新电脑」
# ============================================================

# ---- MySQL 数据库配置（改成你本机 MySQL 的账号密码即可） ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_NAME=pomodoro-quiz-timer

# ---- Web 服务端口 ----
PORT=3000

# ---- CORS 跨域白名单（逗号分隔；* 表示全放行；默认仅放行 Vite dev 前端） ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
