{
  "name": "pomodoro-quiz-timer",
  "version": "1.0.0",
  "description": "刷题计时器 - 前后端分离版（Node + Express + MySQL）",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "init-db": "node server/init-db.js",
    "backup": "node server/backup.js",
    "restore": "node server/restore.js",
    "migrate": "node server/migrate.js",
    "dev": "node --watch server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.11.0"
  }
}
